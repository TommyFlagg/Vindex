rules_version = '2';

// ============================================================================
// FIRESTORE-REGLAR FOR VINDEX
// ----------------------------------------------------------------------------
// Prinsipp:
//   * Bestillingsskjemaet er ope for alle — kven som helst må kunne sende inn
//     ein førespurnad, men ingen skal kunne lese andre sine.
//   * Ein seljar ser og endrar berre sine eigne leads og ordrar.
//   * Admin ser alt og styrer seljarar og distrikt.
//   * Lager ser ordrane (for plukklista) og kan berre flytte status.
//   * settings/ruting er offentleg lesbar fordi skjemaet må finne rett seljar
//     før innlogging — dokumentet inneheld berre id-ar, ingen persondata.
//
// Prisar finst berre i orders/ og på leads, som begge krev innlogging.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function innlogga() {
      return request.auth != null;
    }

    function seljarDok() {
      return get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data;
    }

    // Ein arkivert person har slutta. Raden hans blir ståande — statistikken
    // for selskapet skal ikkje endre seg bakover fordi nokon sluttar — men
    // tilgangen til verktøyet fell bort her, i reglane, og ikkje berre i
    // grensesnittet. Rekkjefølgja er med vilje: exists() må vere sann før
    // get() blir kalla, elles feiler oppslaget for ein som ikkje finst.
    function erSeljar() {
      return innlogga()
             && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
             && seljarDok().get('arkivert', false) != true;
    }

    function rolle() {
      return erSeljar() ? seljarDok().get('rolle', 'selger') : '';
    }

    function erAdmin() {
      return rolle() == 'admin';
    }

    function erLager() {
      return rolle() == 'lager';
    }

    // -- Leads ---------------------------------------------------------------
    // Validering av det bestillingsskjemaet sender inn. Vi held oss til felta
    // skjemaet faktisk bruker, slik at ingen kan dytte inn eigne felt eller
    // sette seg sjølv som solgt kunde.
    function gyldigNyttLead(d) {
      // Nøyaktig det skjemaet sender, og ikkje meir. «tilbud» og «avtaler» sto
      // her utan at skjemaet nokon gong sender dei, og då kunne kven som helst
      // opprette eit lead som alt hadde eit tilbod på seg. Seljarar som
      // registrerer manuelt går gjennom den andre greina og er ikkje råka.
      return d.keys().hasOnly([
               'kilde', 'produkt', 'produkter', 'vedlegg', 'montering', 'tidspunkt',
               'estimat', 'kunde', 'distriktId', 'distriktNavn', 'status', 'samtykke',
               'seljarId', 'tildeltAutomatisk', 'opprettet', 'statusEndret', 'logg'
             ])
             && d.status == 'ny'
             && d.samtykke == true
             && d.kunde.navn is string && d.kunde.navn.size() > 1 && d.kunde.navn.size() < 120
             && d.kunde.telefon is string && d.kunde.telefon.size() < 30
             && d.kunde.epost is string && d.kunde.epost.size() < 160
             && d.kunde.postnr is string && d.kunde.postnr.size() == 4
             && d.kunde.kommentar.size() < 2000
             && d.distriktId is string
             && d.produkt.id is string
             // Skjemaet tek imot fleire produkt: `produkt` er det første av dei
             // og held forma verktøyet ventar, `produkter` har alle.
             //
             // Feltet er valfritt med vilje. Det lyse designet under /lys/ har
             // sitt eige skjema som enno sender berre `produkt`, og eit krav om
             // `produkter` her ville stengt det ute — stille, for kunden ser
             // berre at innsendinga feilar.
             && (!d.keys().hasAny(['produkter'])
                 || (d.produkter is list && d.produkter.size() >= 1
                     && d.produkter.size() <= 12))
             // Bileta kunden la ved. Sjølve filene ligg i Storage og er
             // avgrensa der; her held vi talet nede, så ingen kan feste
             // tusen stiar på eit lead.
             && (!d.keys().hasAny(['vedlegg'])
                 || (d.vedlegg is list && d.vedlegg.size() <= 6))
             && gyldigTildeling(d);
    }

    /** Rutingtabellen: distrikt -> liste med seljar-id-ar. */
    function rutingdata() {
      return get(/databases/$(database)/documents/settings/ruting).data;
    }

    /**
     * Er seljaren på leadet ein som faktisk dekkjer distriktet?
     *
     * Nettlesaren vel seljar sjølv: skjemaet les `settings/ruting` — som er ope,
     * fordi det må lesast før innlogging — og skriv uid-en inn i leadet. Fram
     * til no stod det feltet uvalidert, og då kunne kven som helst sende inn eit
     * lead med kva uid som helst på:
     *
     *   · styre kven i landet som får saka, forbi postnummeret
     *   · eller setje ein uid som ikkje finst, så INGEN seljar ser leadet —
     *     lesregelen krev at seljarId == eigen uid, så det blir liggjande
     *     usynleg for alle andre enn hovudkontoret
     *
     * Heile systemet kviler på at postnummeret avgjer kven som får saka. Står
     * det feltet ope, er ikkje den påstanden sann.
     *
     * Vi kan ikkje rekne postnummer -> distrikt her (den tabellen ligg i JS),
     * men vi kan krevje at seljaren står oppført på distriktet leadet oppgir.
     */
    function gyldigTildeling(d) {
      return (d.seljarId == null && d.tildeltAutomatisk == false)
             || (d.tildeltAutomatisk == true
                 && exists(/databases/$(database)/documents/settings/ruting)
                 && d.distriktId in rutingdata()
                 && rutingdata()[d.distriktId] is list
                 && d.seljarId in rutingdata()[d.distriktId]
                 // Ein Firebase-uid er 28 teikn. Ein seljarrad som er oppretta
                 // i verktøyet og ikkje enno flytta til ein uid, har ein
                 // auto-ID på 20 — og ein slik rad kan ingen logge inn som.
                 // Blir eit lead tildelt den, blir det lagra og deretter
                 // usynleg: seljarverktøyet hentar på «seljarId == min uid»,
                 // og den uid-en finst ikkje. Feilen skjedde i drift, med
                 // Innlandet, og reglane her er den siste staden ho kan
                 // stoppast uansett kva klienten finn på.
                 && d.seljarId is string
                 && d.seljarId.size() == 28);
    }

    // Eit svar på ein bistandsførespurnad kjem frå daglig leder. Utan denne
    // regelen kunne ein seljar skrive svaret sjølv på sitt eige lead, og då
    // ville «daglig leder har godkjent rabatten» ikkje vere verdt noko.
    function berreAdminSvararBistand() {
      return erAdmin()
             || !request.resource.data.keys().hasAny(['bistand'])
             || request.resource.data.bistand.get('status', 'bedt') != 'besvart'
             || request.resource.data.bistand.get('status', 'bedt')
                == resource.data.get('bistand', {}).get('status', '');
    }

    match /leads/{leadId} {
      // Ope for skjemaet, og for seljarar som registrerer leads manuelt.
      allow create: if gyldigNyttLead(request.resource.data)
                    || (erSeljar() && !erLager());
      allow read: if erSeljar()
                  && (resource.data.seljarId == request.auth.uid || erAdmin());
      // Felt som blir sette undervegs i salsløpet: sisteKontakt, fristBrote,
      // arkivert, arkiv, bistand, tilbud (med linjer og fastpris).
      allow update: if erSeljar()
                    && (resource.data.seljarId == request.auth.uid || erAdmin())
                    && berreAdminSvararBistand();
      allow delete: if erAdmin();
    }

    // -- Ordrar --------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if erSeljar() && !erLager();
      allow read: if erSeljar()
                  && (resource.data.seljarId == request.auth.uid || erAdmin() || erLager());
      // Lageret kvitterer ut plukk, men skal ikkje kunne endre mål eller pris.
      allow update: if (erSeljar() && (resource.data.seljarId == request.auth.uid || erAdmin()))
                    || (erLager()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if erAdmin();
    }

    // -- Dagens salstips: kven som har likt kva ------------------------------
    //
    // Uskuldige data, men dei skal framleis ikkje kunne brukast til noko anna
    // enn dei er meint for. Alle innlogga kan lese og like; ingen kan skrive
    // andre felt inn i dokumentet, og berre admin kan slette.
    match /tips/{tipsId} {
      allow read: if erSeljar();
      allow create, update: if erSeljar()
                            && request.resource.data.keys().hasOnly(['likar']);
      allow delete: if erAdmin();
    }

    // -- Seljarar ------------------------------------------------------------
    match /sellers/{uid} {
      allow read: if erSeljar();
      allow create, delete: if erAdmin();
      allow update: if erAdmin()
                    // Ein seljar kan sjølv skru på feriemodus, ingenting anna.
                    || (request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ferie']));
    }

    // -- Kampanjar -----------------------------------------------------------
    // Hovudkontoret lagar dei, alle innlogga les dei. Ein kampanje er ikkje ei
    // personopplysning, men den fortel kva vi gir rabatt på — og det er ikkje
    // noko som skal liggje ope på nettet.
    match /campaigns/{kampanjeId} {
      allow read: if erSeljar();
      allow create, update, delete: if erAdmin();
    }

    // -- Kundeanmeldingar ----------------------------------------------------
    // Alle innlogga les — seljaren skal sjå si eiga vurdering utan å be om det.
    // Berre admin skriv: kva ei anmelding seier, og kven ho høyrer til, skal
    // ikkje kunne endrast av den som blir vurdert.
    match /reviews/{anmeldingId} {
      allow read: if erSeljar();
      allow create, update, delete: if erAdmin();
    }

    // -- Søknader om å bli representant --------------------------------------
    // Skjemaet på nettsida er ope for alle, men søknadene er personopplysningar
    // og skal berre lesast av hovudkontoret. Ingen kan lese sin eigen igjen —
    // det er ikkje ei postkasse, det er ein innboks hos Vindex.
    function gyldigSoknad(d) {
      return d.keys().hasOnly([
               'navn', 'telefon', 'epost', 'postnr', 'firma', 'omDeg',
               'distriktId', 'distriktNavn', 'omradeLedig', 'status',
               'samtykke', 'opprettet',
             ])
             && d.samtykke == true
             && d.status == 'ny'
             && d.navn is string && d.navn.size() > 1 && d.navn.size() < 120
             && d.telefon is string && d.telefon.size() < 30
             && d.epost is string && d.epost.size() < 160
             && d.postnr is string && d.postnr.size() == 4
             && d.firma.size() < 160
             && d.omDeg.size() < 4000
             && d.distriktId is string;
    }

    match /representanter/{soknadId} {
      allow create: if gyldigSoknad(request.resource.data);
      allow read, update, delete: if erAdmin();
    }

    // -- Innstillingar -------------------------------------------------------
    match /settings/ruting {
      allow read: if true;          // skjemaet treng dette før innlogging
      allow write: if erAdmin();
    }

    // Omtaler hovudkontoret har sleppt ut på nettsida.
    //
    // Sjølve samlinga `reviews` krev innlogging — der står namn, poststad og
    // kva seljar saka høyrer til. Dette dokumentet er kopien som er meint å
    // stå ute, og inneheld berre stjerner, tekst, namn og stad. Skiljet er
    // med vilje: det som er ope skal vere ope fordi nokon har bestemt det,
    // ikkje fordi det låg i same samlinga som noko anna.
    match /settings/omtaler {
      allow read: if true;
      allow write: if erAdmin();
    }

    match /settings/{dokument} {
      allow read: if erSeljar();
      allow write: if erAdmin();
    }

    // -- Omsetning per person ------------------------------------------------
    //
    // Desse tala låg inne i seljardokumentet. `sellers` blir lese av alle
    // innlogga — det er slik kollegaer finn kvarandre og slik namn kjem opp i
    // lister — og då kunne kvar av dei elleve eksterne forhandlarane lese kva
    // alle dei andre hadde selt. Verktøyet viste det aldri, men reglane er det
    // som avgjer kva som er lesbart, ikkje kva grensesnittet teiknar.
    //
    // Seljarsida treng ikkje tala i det heile: topplista blir rekna av ordrane
    // i verktøyet. Berre hovudkontoret les dei, og difor står dei her.
    match /omsetning/{uid} {
      allow read, write: if erAdmin();
    }

    // Prisliste, provisjonssatsar og omsetningstal.
    //
    // Desse låg tidlegare i js/modellar.js, js/provisjon.js og js/team.js.
    // Dei filene blir lasta av selger.html, som er ei open adresse, og då kunne
    // kven som helst laste ned heile prislista og provisjonsarket utan å logge
    // inn. Innhaldet ligg her no, og då er det denne regelen som avgjer kven
    // som ser det — ikkje kva nettstaden tilfeldigvis serverer.
    //
    // Lageret les òg: plukklista viser varenamn og kodar frå same lista.
    match /prisdata/{dokument} {
      allow read: if erSeljar();
      allow write: if erAdmin();
    }

    // ========================================================================
    // LAGER OG INNKJØP
    // ------------------------------------------------------------------------
    // Innkjøpsprisane er det mest følsame selskapet har. Dei er delte i to
    // samlingar med vilje, og skiljet er ikkje kosmetisk:
    //
    // Firestore-reglar verkar på DOKUMENT, ikkje på felt. Ein regel kan ikkje
    // seie «du får lese denne varen, men ikkje feltet innkjøpspris» — får du
    // lese dokumentet, får du heile dokumentet, uansett kva grensesnittet
    // vel å teikne. Difor kan ikkje innkjøpsprisen liggje på varen.
    //
    //   varer/{artnr}     namn, gruppe, enhet, mål, veil.pris, struktur
    //                     -> seljar les (tilbodet treng varenamn og kodar)
    //   innkjop/{artnr}   innkjøpspris, valuta, kurs, kostfaktor, kostpris
    //                     -> berre hovudkontoret, aldri seljar
    //
    // Same artikkelnummer i begge, men to dokument. Ein seljar som hentar heile
    // `varer` får ikkje ei einaste innkjøpsline med på lasset.
    // ========================================================================

    // Varekortet slik seljaren treng det. Innkjøpsfelta er nemnde ved namn og
    // avviste her òg — ikkje fordi verktøyet ville skrive dei, men fordi ein
    // feil ein gong i framtida elles ville lekke prisane stille inn i ei
    // samling alle les.
    function utanInnkjopstal(d) {
      return !d.keys().hasAny([
        'innkjopspris', 'innkjop', 'kostpris', 'kostfaktor', 'valuta', 'kurs',
        'paaslag', 'leverandorpris', 'kostverdi'
      ]);
    }

    match /varer/{artnr} {
      allow read: if erSeljar();
      allow create, update: if erAdmin() && utanInnkjopstal(request.resource.data);
      allow delete: if erAdmin();
    }

    // Innkjøpsprisen og heile kjeda fram til kostpris. Ingen andre enn
    // hovudkontoret, og ingen unntak: ikkje lager, ikkje seljar, ikkje
    // innlogga-og-elles-snill. Dette er den eine regelen i fila som ikkje
    // skal mjuknast utan at nokon seier det høgt.
    match /innkjop/{artnr} {
      allow read, write: if erAdmin();
    }

    // Lagerrørsler. Saldoen er ikkje eit tal som ligg lagra nokon stad — han
    // er summen av desse linjene. Det er difor vi kan svare på kva som stod på
    // lager 31.12., og difor to ordrar som blir stadfesta samtidig ikkje kan
    // skrive over kvarandre.
    //
    // Ei rørsle blir aldri endra eller sletta. Ein feil blir retta med ei ny
    // linje som peikar på den gamle, slik ein rettar i eit rekneskap. Difor
    // står det create her og ikkje write.
    function gyldigRorsle(d) {
      return d.artnr is string
             && d.antall is number
             && d.type in ['innkjop', 'ordre', 'telling', 'produksjon', 'retur', 'svinn']
             && d.tid is string
             // Kostpris høyrer ikkje heime på rørsla: lageret les desse.
             && utanInnkjopstal(d);
    }

    match /lagerpost/{postId} {
      allow read: if erAdmin() || erLager();
      allow create: if (erAdmin() || erLager()) && gyldigRorsle(request.resource.data);
      allow update, delete: if false;
    }

    // Innkjøpsordrane. Linjene har einingsprisar i leverandørens valuta, så
    // dette er like følsamt som `innkjop` og blir behandla likt.
    match /bestilling/{ponr} {
      allow read, write: if erAdmin();
    }
  }
}
