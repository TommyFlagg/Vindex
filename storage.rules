// ============================================================================
// VINDEX — REGLAR FOR FILLAGER (Firebase Storage)
// ----------------------------------------------------------------------------
// Her ligg vedlegga til ordrane: skisser frå befaringa, foto av staden, PDF-ar
// frå arkitekten. Dei inneheld kundeadresser og bilete av folk sine hus, og
// skal difor aldri vere opne.
//
// Skru på Storage i Firebase-konsollen og publiser desse reglane saman med
// firestore.rules. Utan dette steget vil opplasting frå ordreseddelen feile.
// ============================================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function innlogga() {
      return request.auth != null;
    }

    function seljarDok() {
      return firestore.get(/databases/(default)/documents/sellers/$(request.auth.uid)).data;
    }

    // Same krav som i firestore.rules: ein arkivert person har slutta og skal
    // ikkje kome inn. Utan denne sto vedlegga opne for alle med eit gyldig
    // passord, sjølv etter at Firestore hadde stengt dei ute — teikningar og
    // bilete av kundane sine hus, altså.
    function erSeljar() {
      return innlogga()
             && firestore.exists(/databases/(default)/documents/sellers/$(request.auth.uid))
             && seljarDok().get('arkivert', false) != true;
    }

    function rolle() {
      return seljarDok().rolle;
    }

    function erAdmin() {
      return erSeljar() && rolle() == 'admin';
    }

    function erLager() {
      return erSeljar() && rolle() == 'lager';
    }

    // Vedlegg til ordrar.
    //
    // Lesing: alle aktive i apparatet. Lageret må sjå skissa for å plukke
    // rett, produksjonen for å lage rett, seljaren for å kontrollere.
    // Kunden er ikkje innlogga og kjem ikkje til.
    //
    // Skriving: seljarar og admin. Lageret les, men endrar ikkje.
    //
    // Sletting: berre admin. Ei skisse som forsvinn etter at ordren er sett i
    // produksjon, er ei skisse ingen kan gå tilbake til.
    match /ordrar/{ordreId}/{fil} {
      allow read: if erSeljar();
      allow write: if erSeljar() && !erLager()
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if erAdmin();
    }

    // Bilete kunden la ved då han bad om tilbod.
    //
    // Her er den som lastar opp IKKJE innlogga — skjemaet er ope, det er heile
    // poenget. Difor er dette den einaste staden i reglane der ein framand kan
    // skrive, og den er snevra inn så langt det går:
    //
    //   · berre nye filer (`resource == null`), så ingen kan byte ut eit bilete
    //     som alt ligg der, og ingen kan overskrive noko dei ikkje la sjølv
    //   · berre bilete, og under 6 MB — vår eigen kode krympar til ~300 kB, så
    //     taket er ein grense mot misbruk, ikkje mot vanleg bruk
    //   · ingen lesing. Nettlesaren som lasta opp får aldri ei lenke tilbake;
    //     stien står på leadet, og seljaren hentar biletet med si innlogging
    //   · mappenamnet er tilfeldig, så ein annan kunde sine bilete kan ikkje
    //     gjettast fram
    //
    // Merk: reglar kan ikkje hindre at nokon lastar opp mange gonger. Skru på
    // Firebase App Check på Storage — det er det som stengjer ute skript som
    // ikkje kjem frå nettsida vår.
    match /kundebilete/{mappe}/{fil} {
      allow read: if erSeljar();
      allow create: if resource == null
                    && request.resource.size < 6 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if erAdmin();
    }

    // Alt anna er stengt. Nye mappar må leggast inn her med vilje.
    match /{alle=**} {
      allow read, write: if false;
    }
  }
}
